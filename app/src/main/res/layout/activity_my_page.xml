<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:background="@drawable/my_page_background"
    android:layout_height="match_parent"
    tools:context=".myPage.MyPageActivity">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="홈"
        android:id="@+id/back_btn"
        android:layout_marginLeft="42dp"
        android:layout_marginTop="34dp"/>

    <GridLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:columnCount="2"
        android:rowCount="2"
        android:padding="24dp"
        android:orientation="horizontal">

        <!-- 프로필 이미지 -->
        <ImageView
            android:layout_width="127dp"
            android:layout_height="127dp"
            android:layout_marginTop="30dp"
            android:layout_marginLeft="15dp"
            android:src="@drawable/profile" />

        <!-- 이름 + 이메일 -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginTop="70dp"
            android:layout_marginLeft="30dp"
            android:gravity="center_vertical">
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="이소정"
                android:textColor="#585858"
                android:id="@+id/name"
                android:textSize="16sp"
                android:layout_marginBottom="4dp" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/email"
                android:text="dlthwjd1629@gmail.com"
                android:textColor="#C6C6C6"
                android:textSize="12sp" />
        </LinearLayout>
    </GridLayout>

    <ImageView
        android:layout_width="350dp"
        android:layout_height="wrap_content"
        android:scaleType="fitXY"
        android:src="@drawable/line"
        android:layout_gravity="center_horizontal"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <TextView
            android:id="@+id/patch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="수정하기"
            android:layout_marginTop="26dp"
            android:layout_marginLeft="130dp"
            android:textColor="#0096D1"
            android:textSize="10dp" />

        <!-- 나이 -->
        <TextView
            android:id="@+id/age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginLeft="195dp"
            android:layout_marginTop="32dp"
            android:textColor="#585858"
            android:textStyle="bold"/>

        <EditText
            android:id="@+id/edit_age"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="#585858"
            android:layout_marginTop="60dp"
            android:textSize="15dp"
            android:layout_marginLeft="195dp"/>

        <!-- 키/몸무게 -->
        <TextView
            android:id="@+id/h_and_w"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginTop="18dp"
            android:layout_marginLeft="195dp"
            android:textColor="#585858"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_h_and_w"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="#585858"
            android:textSize="15dp"
            android:layout_marginLeft="195dp" />

        <!-- 직업 -->
        <TextView
            android:id="@+id/job"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginTop="18dp"
            android:layout_marginLeft="195dp"
            android:textColor="#585858"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_job"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="#585858"
            android:textSize="15dp"
            android:layout_marginLeft="195dp" />

        <!-- 건강 -->
        <TextView
            android:id="@+id/health"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginTop="18dp"
            android:layout_marginLeft="195dp"
            android:textColor="#585858"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_health"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="#585858"
            android:textSize="15dp"
            android:layout_marginLeft="195dp" />

        <!-- 알러지 -->
        <TextView
            android:id="@+id/allergy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginTop="18dp"
            android:layout_marginLeft="195dp"
            android:textColor="#585858"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_allergy"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="#585858"
            android:textSize="15dp"
            android:layout_marginLeft="195dp" />

        <!-- 기타 -->
        <TextView
            android:id="@+id/etc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text=""
            android:layout_marginTop="18dp"
            android:layout_marginLeft="195dp"
            android:textColor="#585858"
            android:textStyle="bold" />

        <EditText
            android:id="@+id/edit_etc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:textColor="#585858"
            android:textSize="15dp"
            android:layout_marginLeft="195dp" />

        <ImageView
            android:layout_gravity="center"
            android:layout_width="300dp"
            android:layout_height="40dp"
            android:visibility="gone"
            android:layout_marginTop="30dp"
            android:id="@+id/save_btn"
            android:src="@drawable/save_btn"/>

    </LinearLayout>

</LinearLayout>