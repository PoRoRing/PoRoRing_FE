<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".mainPage.LoginActivity">

    <ImageView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:src="@drawable/login"/>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_gravity="bottom"
        android:padding="32dp">

        <EditText
            android:id="@+id/authEmailEditView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="이메일"
            android:inputType="textEmailAddress"
            android:textColor="#000000"
            android:backgroundTint="#338CAF"
            android:textSize="13sp"
            android:padding="10dp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="10dp" />
        <EditText
            android:id="@+id/authPasswordEditView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:hint="비밀번호 - 6자 이상"
            android:inputType="textPassword"
            android:textColor="#000000"
            android:backgroundTint="#338CAF"
            android:textSize="13sp"
            android:padding="10dp" />
        <View
            android:layout_width="match_parent"
            android:layout_height="20dp" />
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:id="@+id/loginBtn"
            android:layout_marginBottom="5dp"
            android:src="@drawable/login_btn"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:id="@+id/signBtn"
            android:layout_marginBottom="5dp"
            android:src="@drawable/signok_btn"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:id="@+id/goSignInBtn"
            android:layout_marginBottom="5dp"
            android:src="@drawable/sign_btn"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:id="@+id/logoutBtn"
            android:layout_marginBottom="5dp"
            android:src="@drawable/logout_btn"/>
        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="50dp"
            android:id="@+id/googleLoginBtn"
            android:layout_marginBottom="5dp"
            android:src="@drawable/google_btn"/>
    </LinearLayout>
</FrameLayout>